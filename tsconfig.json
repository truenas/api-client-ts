{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "test-data/*": ["test-data/*"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src"],
  // `*.spec-d.ts` are type tests, checked by tsconfig.spec.json. Without them
  // excluded here they also compile into the library program — which drags
  // vitest's declarations into a graph that has `declaration: true`, and
  // quadruples this config's type count for no benefit.
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.spec-d.ts"]
}
